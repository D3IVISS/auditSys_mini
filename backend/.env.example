# Puerto HTTP local (Render inyecta PORT automáticamente en producción)
PORT=5000
NODE_ENV=development

# Supabase → Project Settings → Database → Connection string → URI
# Use "Session pooler" (puerto 5432) o "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# true para Supabase / Render; false solo para un PostgreSQL local sin TLS
DATABASE_SSL=true

# Orígenes permitidos por CORS, separados por coma. Admite comodín de subdominio:
# https://auditsys-mini.vercel.app,https://*.vercel.app
FRONTEND_URL=http://localhost:5173
